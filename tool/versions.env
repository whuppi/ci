# Single source of truth for pinned tool + binary versions used by whuppi/ci's
# composite actions and reusable workflows. Sourced by the scripts that need
# them — bump in ONE place, never inline. Plain `KEY="value"` so it's both
# shell-sourceable and trivially greppable.
#
#   source "$CI_ROOT/tool/versions.env"
#
# Every entry here is a pinned EXTERNAL tool/binary that CI downloads and
# hash-verifies through tool/fetch_verified.sh.
#
# Who bumps what:
#   tool/ci/upgrade.sh (via self-upgrade.yml, daily PR in THIS repo) —
#       everything in this file: FVM_*, CHROME_*, ACTIONLINT_VERSION,
#       ZIZMOR_VERSION, PINACT_VERSION, BORE_*, ORAS_*. One bump reaches every consumer
#       through the next whuppi/ci release.
#   Dependabot (in THIS repo)  — GitHub-action SHAs pinned in the workflows.
#   Consumer repos             — their own Flutter SDK (.fvmrc) + lockfiles,
#       via the reusable upgrade-check.yml.

# fvm TOOL — downloaded + verified by actions/capabilities/fvm. Pins the tool;
# the Flutter SDK itself is pinned separately by each consumer's .fvmrc.
# Hashes self-computed from the release assets (leoafarias/fvm publishes no
# digests).
FVM_VERSION="4.3.2"
FVM_SHA256_LINUX_X64="17dfced05f5b0cb32398dadd0691acc2bc458e8c4b0045a781cd5aa6c85f6ecb"
FVM_SHA256_MACOS_ARM64="c9b1e67e5ff4ddae4710669ff9aa312f750947f68fac5b15fc5d248fb4419342"
FVM_SHA256_MACOS_X64="66a4e7c8907ba6141eea13168af54be01f07258162ee1d0ed82299b37302e7d2"
FVM_SHA256_WINDOWS_X64="97696d118ad35bf25dc91fd28c70bb3d77b6d1fee6658fbd744e838b5f81da4a"

# actionlint — workflow linter run in the reusable pr-checks gate. Go-installed
# by this tag; Go verifies the module checksum, so no separate sha is tracked.
ACTIONLINT_VERSION="1.7.12"

# zizmor — the security half of the pr-checks gate, run via `pipx run`. pipx
# resolves the version from PyPI, so no separate sha is tracked.
#
# Held below 1.30.0: zizmor 1.30 adds a `self-repository` audit that wants
# in-repo actions referenced as `uses: $/…`, and actionlint (1.7.12, the
# latest) rejects that form — the two gates contradict and no spelling
# passes both. upgrade.sh proposes nothing at or above the hold. Lift it
# when actionlint accepts `$/` (rhysd/actionlint#711), then move the
# three `./` sites in self-check.yml to `$/`.
ZIZMOR_VERSION="1.29.0"
ZIZMOR_HOLD_BELOW="1.30.0"

# pinact — pins third-party actions inside composite action.yml to a SHA in the
# composite-refs sweep (upgrade-check.yml), closing the dependabot-core#6704
# blind spot. Go-installed by this tag; Go verifies the module checksum, so no
# separate sha is tracked.
PINACT_VERSION="5.0.2"

# ── Pinned binary downloads (verified via tool/fetch_verified.sh) ──
# sha256 values are the upstream-published digest where one exists, else
# self-computed from the release asset. Bump alongside the version.

# bore tunnel binary (actions/debug-ssh). The action sources this file and
# builds its download URLs from BORE_VERSION, so the version lives here beside
# its hashes — one place for upgrade.sh to bump.
BORE_VERSION="v0.6.0"
BORE_SHA256_LINUX_X64="e484d1e3acba77169b773f31a5bfb34192d4b660f44a094a658a2522cd2270f7"
BORE_SHA256_MACOS_ARM64="65f43a67b90874700538bdb6064c5e92276e64dfba24f5cd72ef24a035eec3bc"
BORE_SHA256_WINDOWS_X64="01709c64fe2787cdc9a21d7030b0f08ad72dff0c36b7ecb72f4f667a55a34b4f"

# Chrome for Testing — chrome + chromedriver pinned per platform, so web tests
# run a verified, reproducible browser (actions/capabilities/chrome).
# chrome-for-testing publishes no digests, so these are self-computed.
# upgrade.sh re-bumps on Chrome's ~4-week Stable cadence; the CDN prunes old
# versions, so the pin must be kept fresh or the download 404s.
CHROME_VERSION="156.0.8078.47"
CHROME_SHA256_LINUX_X64="e6c94490f0b6b337225aeb2d2a5034858516b7017356980ba94f5176d8774a50"
CHROME_SHA256_MACOS_ARM64="ad7f2b49a4dc679af286b1b1b386670d93ca7868079f69012d21ba0ac8293df3"
CHROME_SHA256_WINDOWS_X64="a4e0d57245e167e98a9d465af1e3774d2b4ec9f04e483d19bcd97a6f63cf46dd"
CHROMEDRIVER_SHA256_LINUX_X64="2a5024610c53f340a1aaa5d9a3e2a4fa448be7d71cca5238bd8c3c7f16181df4"
CHROMEDRIVER_SHA256_MACOS_ARM64="f42d25b984e2185ee48a628f0e76d49fcdf2fa83f20f7c286880dddeb4a28cc9"
CHROMEDRIVER_SHA256_WINDOWS_X64="024ee8cafa622e31cd0c3092c7a6b3548248bde7f68317d7415408dcd03ae510"

# oras — the OCI client actions/capabilities/oci-cache uses to push and pull
# cache archives to the GitHub Container Registry (free and uncapped for
# public packages, the way round the 10 GB Actions-cache quota). Pinned and
# verified on EVERY OS, including Linux where the runner image ships a copy:
# an unpinned tool is a tool that changes under CI. Hashes from the release's
# own checksums file, re-verified by upgrade.sh on every bump.
ORAS_VERSION="1.3.6"
ORAS_SHA256_LINUX_X64="66fb0ad7206f3f6fa77ed5b552049d364ccf4b50b1684554f731f76302b52ca0"
ORAS_SHA256_MACOS_ARM64="e2b25a53234e2471c5fc81936f957fa612065ab559c21834c02d8bfbc2f62b30"
ORAS_SHA256_MACOS_X64="844e26430aa0afe2c40fdbddafc3b39ef968a6d41955b7380684bd02907fa397"
ORAS_SHA256_WINDOWS_X64="ec3d19f386d5d2f0892288772d7b242475a05332aafa64b6773378ca771d76d3"
